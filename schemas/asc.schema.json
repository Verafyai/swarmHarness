{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verafyai/verafyHarness/schemas/asc.schema.json",
  "title": "Actually Smart Contract (verafy.asc/1)",
  "type": "object",
  "required": [
    "kind",
    "id",
    "instructions",
    "context",
    "question",
    "payment",
    "exits"
  ],
  "properties": {
    "kind": {
      "enum": ["verafy.asc/1", "swarm.asc/0"],
      "description": "verafy.asc/1 for new contracts. swarm.asc/0, the kind before the rename, still validates, and a contract that carries it keeps its hash."
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "instructions": {
      "type": "string",
      "description": "The compressed intention: what to decide and how to judge it."
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "link",
              "text",
              "policy",
              "document",
              "repo",
              "ruling"
            ],
            "description": "ruling: a prior ruling carried as evidence, such as the ruling under challenge."
          },
          "url": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "description": "For kind repo: the pinned commit."
          },
          "snapshotAt": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string",
            "description": "Snapshot text. Optional on chain; fetched from the availability layer by sha256."
          },
          "label": {
            "type": "string",
            "description": "Shown to jurors, such as \"new evidence\" on a challenge."
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "prompt",
        "answer"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "answer": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "verdict",
                "forecast",
                "graded"
              ]
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "tolerance": {
              "type": "number",
              "description": "Forecasts: spread at which agreement reaches zero."
            }
          }
        }
      }
    },
    "payment": {
      "type": "object",
      "required": [
        "escrow",
        "currency",
        "bar",
        "jury",
        "split"
      ],
      "properties": {
        "escrow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string"
        },
        "bar": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Agreement the jury must reach."
        },
        "maxValuePerVote": {
          "type": "number",
          "description": "Minimum bond a juror must hold."
        },
        "jury": {
          "type": "object",
          "required": [
            "size",
            "minLabs"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "minLabs": {
              "type": "integer",
              "minimum": 1
            },
            "quorum": {
              "type": "integer",
              "minimum": 1
            },
            "assurance": {
              "enum": [
                "L0",
                "L1",
                "L1+",
                "L2",
                "L3"
              ],
              "description": "Minimum assurance for the AI that rules: L1+ re-executable, L2 a proof of inference per vote."
            },
            "excludeLabs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Labs that may not sit, such as the original jury's labs on an escalated or challenge jury."
            },
            "excludeHarnesses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Harness ids that may not sit."
            }
          }
        },
        "split": {
          "type": "object",
          "required": [
            "jurors",
            "auditors",
            "storage",
            "sealer"
          ],
          "properties": {
            "jurors": {
              "type": "number"
            },
            "auditors": {
              "type": "number"
            },
            "storage": {
              "type": "number"
            },
            "sealer": {
              "type": "number"
            }
          }
        },
        "chain": {
          "type": "string",
          "description": "The chain the escrow is held on, such as solana or ethereum."
        },
        "source": {
          "type": "object",
          "description": "Optional. Where the escrow is held on its source chain, for the light-client funding check at intake. Leaving it out changes nothing for existing contracts.",
          "properties": {
            "chain": {
              "type": "string",
              "description": "Defaults to payment.chain. \"solana\", \"ethereum\", or \"evm:<chainId>\"."
            },
            "account": {
              "type": "string",
              "description": "Solana: the escrow account (an SPL token account when mint is set)."
            },
            "mint": {
              "type": "string",
              "description": "Solana: the SPL mint, such as USDC."
            },
            "address": {
              "type": "string",
              "description": "EVM: the escrow address."
            },
            "token": {
              "type": "string",
              "description": "EVM: the ERC-20 contract; omit for the native asset."
            },
            "decimals": {
              "type": "integer",
              "minimum": 0
            },
            "native": {
              "type": "boolean",
              "description": "Check the chain's native balance (SOL, ETH) when the currency is not SOL or ETH by name."
            }
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "outcome",
          "effect"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "description": "An option, *forecast, or *below-bar."
          },
          "effect": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "pay",
                  "refund",
                  "hold",
                  "record",
                  "call",
                  "escalate"
                ]
              },
              "chain": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "args": {
                "type": "array"
              },
              "jurySize": {
                "type": "integer"
              },
              "hours": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          },
          "exitProgram": {
            "type": "object",
            "description": "Optional. An exit program TinySVM or runtime.js runs with the ruling's params: the program's SHA-256, its entry point, the params schema that bounds what the jury may supply, and fixed args (amounts in base units, account names). Absent, the exit behaves as before and the contract keeps its hash.",
            "required": [
              "programHash",
              "entry"
            ],
            "properties": {
              "programHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "entry": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "min",
                        "max"
                      ],
                      "properties": {
                        "type": {
                          "const": "integer"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "size"
                      ],
                      "properties": {
                        "type": {
                          "const": "ranking"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "of": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  ]
                }
              },
              "args": {
                "type": "object"
              },
              "computeCap": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1400000
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "Present on a challenge contract: the sealed ruling it reviews.",
      "required": [
        "kind",
        "ruling",
        "ascHash",
        "grounds"
      ],
      "properties": {
        "kind": {
          "const": "swarm.challenge/0"
        },
        "ruling": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The challenged ruling id."
        },
        "ascHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The challenged contract hash."
        },
        "grounds": {
          "enum": [
            "new-evidence",
            "false-evidence",
            "error",
            "changed-rules"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "Hashes of the new material."
        }
      }
    },
    "escalation": {
      "type": "object",
      "description": "Present on an escalated contract: funded by exactly the escrow a below-bar ruling carried.",
      "required": [
        "kind",
        "from",
        "ascHash",
        "account",
        "carried"
      ],
      "properties": {
        "kind": {
          "const": "swarm.escalation/0"
        },
        "from": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The below-bar ruling id."
        },
        "ascHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "account": {
          "type": "string",
          "pattern": "^escrow:"
        },
        "carried": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
